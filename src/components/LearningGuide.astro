---
import LucideIcon from './LucideIcon.astro';

interface Guide {
  summary: string;
  mentalModel: string;
  why: string;
  steps: string[];
  mistakes: string[];
  check: string[];
  bridge: string;
}

interface Props {
  guide: Guide;
  lessonTitle: string;
}

const { guide, lessonTitle } = Astro.props;
---
<section id="penjelasan-mudah" class="learning-guide" aria-labelledby="penjelasan-mudah-title">
  <div class="learning-guide__heading">
    <div>
      <span class="source-kicker">PENJELASAN TAMBAHAN</span>
      <h2 id="penjelasan-mudah-title">Penjelasan mudah dipahami</h2>
      <p>Bagian ini menyederhanakan konsep pada <strong>{lessonTitle}</strong> ke mental model, langkah kerja, dan kesalahan umum. Materi PDF asli tetap tersedia di bagian berikutnya.</p>
    </div>
    <span class="learning-guide__badge"><LucideIcon name="graduation-cap" size={18} /> Dari konsep ke praktik</span>
  </div>

  <div class="learning-guide__summary">
    <span class="learning-guide__icon"><LucideIcon name="info" size={20} /></span>
    <div>
      <h3>Inti dalam 60 detik</h3>
      <p>{guide.summary}</p>
    </div>
  </div>

  <div class="learning-guide__cards">
    <article class="learning-guide__card learning-guide__card--model">
      <span class="learning-guide__icon"><LucideIcon name="compass" size={20} /></span>
      <div>
        <h3>Mental model</h3>
        <p>{guide.mentalModel}</p>
      </div>
    </article>
    <article class="learning-guide__card learning-guide__card--why">
      <span class="learning-guide__icon"><LucideIcon name="target" size={20} /></span>
      <div>
        <h3>Kenapa ini penting?</h3>
        <p>{guide.why}</p>
      </div>
    </article>
  </div>

  <div class="learning-guide__grid">
    <section class="learning-guide__panel">
      <div class="learning-guide__panel-title">
        <LucideIcon name="workflow" size={19} />
        <h3>Urutan berpikir</h3>
      </div>
      <ol class="learning-guide__steps">
        {guide.steps.map((step) => <li>{step}</li>)}
      </ol>
    </section>

    <section class="learning-guide__panel learning-guide__panel--warning">
      <div class="learning-guide__panel-title">
        <LucideIcon name="circle-help" size={19} />
        <h3>Kesalahan yang sering terjadi</h3>
      </div>
      <ul class="learning-guide__mistakes">
        {guide.mistakes.map((mistake) => <li>{mistake}</li>)}
      </ul>
    </section>
  </div>

  <section class="learning-guide__check">
    <div class="learning-guide__panel-title">
      <LucideIcon name="circle-check" size={19} />
      <h3>Cek pemahaman tanpa melihat catatan</h3>
    </div>
    <ol>
      {guide.check.map((item) => <li>{item}</li>)}
    </ol>
  </section>

  <div class="learning-guide__bridge">
    <LucideIcon name="arrow-right" size={18} />
    <p><strong>Hubungkan ke langkah berikutnya:</strong> {guide.bridge}</p>
  </div>
</section>
