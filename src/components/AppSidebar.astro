---
import LucideIcon from './LucideIcon.astro';
import { learningNavigation } from '../lib/navigation';

interface Props {
  path: string;
  chapter?: number;
}

const { path } = Astro.props;
---
<aside id="sidebar" class="sidebar">
  <button id="close-nav" class="mobile-toggle sidebar-close" aria-label="Tutup navigasi">
    <LucideIcon name="x" />
    <span>Tutup</span>
  </button>

  <nav aria-label="Menu utama">
    <a class:list={['side-home', { active: path === '/' }]} href="/">
      <LucideIcon name="home" size={17} />
      <span>Ruang kerja</span>
    </a>

    <div class="sidebar-label">WORKSPACE</div>
    {learningNavigation.map((item) => (
      <a class:list={['side-link', { active: path === item.href }]} href={item.href}>
        <LucideIcon name={item.icon} size={16} />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-foot">
    <a href="/referensi/">Referensi</a>
    <a href="/tentang/">Tentang</a>
    <p>Bangun. Uji. Kembangkan.</p>
  </div>
</aside>
