---
import Layout from '../../../layouts/Layout.astro';
import Bookmark from '../../../components/Bookmark.vue';
import LessonTools from '../../../components/LessonTools.vue';
import LucideIcon from '../../../components/LucideIcon.astro';
import lessons from '../../../data/lessons.json';
import sourceLibrary from '../../../data/source-library.json';
import { catalog, checkpoints } from '../../../lib/catalog';

export function getStaticPaths() {
  return lessons.map((lesson) => ({
    params: { bagian: lesson.part, bab: lesson.slug },
    props: { lesson },
  }));
}

const { lesson } = Astro.props as { lesson: (typeof lessons)[number] };
const current = catalog.find((item) => item.id === lesson.id)!;
const index = catalog.findIndex((item) => item.id === lesson.id);
const previous = index > 0 ? catalog[index - 1] : undefined;
const next = index < catalog.length - 1 ? catalog[index + 1] : undefined;
const sourceMap = new Map(sourceLibrary.map((source) => [source.id, source]));
const sourceGroups = lesson.sourceRefs.map((ref) => ({
  ...ref,
  source: sourceMap.get(ref.sourceId),
})).filter((group) => group.source);
const headings = [
  { depth: 2, slug: 'agenda-sesi', text: 'Agenda sesi' },
  { depth: 2, slug: 'tujuan-belajar', text: 'Tujuan belajar' },
  { depth: 2, slug: 'alur-belajar', text: 'Alur belajar' },
  { depth: 2, slug: 'materi-sumber', text: 'Materi sumber lengkap' },
  { depth: 2, slug: 'latihan-praktik', text: 'Latihan praktik' },
  { depth: 2, slug: 'checkpoint', text: 'Checkpoint' },
];
---
<Layout title={current.title} description={current.description} headings={headings} chapter={current.chapter} wide>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/belajar/">36 Sesi</a>
    <span>/</span>
    <a href={`/belajar/${current.part}/`}>{current.partTitle}</a>
    <span>/ Sesi {String(current.chapter).padStart(2, '0')}</span>
  </nav>

  <section class={`session-hero session-hero--${current.part}`}>
    <div>
      <span class="page-kicker">{current.partTitle.toUpperCase()}</span>
      <h1>{current.title}</h1>
      <p class="intro">{current.description}</p>
    </div>
    <div class="session-stats" aria-label="Informasi sesi">
      <strong>S{String(current.chapter).padStart(2, '0')}</strong>
      <span>180 menit</span>
      <span>{sourceGroups.length} blok sumber</span>
    </div>
  </section>

  <div class="reading-controls" aria-label="Pengaturan baca">
    <button type="button" data-size="0.9" aria-label="Perkecil teks">A−</button>
    <button type="button" data-size="1" aria-label="Ukuran teks standar">A</button>
    <button type="button" data-size="1.15" aria-label="Perbesar teks">A+</button>
    <button type="button" id="focus-mode" aria-pressed="false"><LucideIcon name="focus" size={15} /><span>Mode fokus</span></button>
    <label>
      <span class="sr-only">Lebar baca</span>
      <select id="reading-width">
        <option value="normal">Lebar normal</option>
        <option value="comfortable">Lebar nyaman</option>
      </select>
    </label>
    <a class="button" href="/offline/"><LucideIcon name="hard-drive-download" size={15} /><span>Kelola offline</span></a>
  </div>

  <section id="agenda-sesi" class="session-agenda">
    <div class="section-heading section-heading--strong">
      <div><span class="section-number">01</span><h2>Agenda sesi</h2></div>
      <span class="source-chip">FORMAT 3 JAM</span>
    </div>
    <div class="agenda-grid">
      {current.agenda.map((item) => (
        <article class:list={['agenda-item', { 'agenda-item--break': item.label === 'Istirahat' }]}>
          <span>{item.time}</span>
          <strong>{item.label}</strong>
          <small>{item.minutes} menit</small>
        </article>
      ))}
    </div>
  </section>

  <section id="tujuan-belajar" class="session-panel">
    <div class="section-heading section-heading--strong">
      <div><span class="section-number">02</span><h2>Tujuan belajar</h2></div>
    </div>
    <div class="objective-grid">
      {current.objectives.map((objective, i) => (
        <article class={`objective-card objective-card--${(i % 3) + 1}`}>
          <span>0{i + 1}</span>
          <p>{objective}</p>
        </article>
      ))}
    </div>
  </section>

  <section id="alur-belajar" class="session-panel">
    <div class="section-heading section-heading--strong">
      <div><span class="section-number">03</span><h2>Alur belajar</h2></div>
    </div>
    <div class="learning-flow-grid">
      {current.learningFlow.map((step, i) => (
        <article class="learning-flow-card">
          <span>{String(i + 1).padStart(2, '0')}</span>
          <strong>{step}</strong>
        </article>
      ))}
    </div>
    <p class="communication-note"><LucideIcon name="message-circle" size={17} /><span><strong>Komunikasi:</strong> {current.communicationFocus}</span></p>
  </section>

  <article class="prose session-content">
    <section id="materi-sumber" class="source-material-section">
      <div class="section-heading section-heading--strong">
        <div><span class="section-number">04</span><h2>Materi sumber lengkap</h2></div>
      </div>
      <p>Seluruh unit yang dipetakan ke sesi ini ditampilkan di bawah. Teks, contoh kode, checklist, tabel, dan catatan speaker dipertahankan dari berkas sumber. Bagian ini menjadi bahan baca utama sesi.</p>

      {sourceGroups.map((group, groupIndex) => {
        const units = group.source!.units.filter((unit) => unit.unit >= group.start && unit.unit <= group.end);
        return (
          <section class="source-group">
            <div class="source-group__header">
              <div>
                <span class="source-kicker">SUMBER {String(groupIndex + 1).padStart(2, '0')}</span>
                <h3>{group.source!.shortTitle}</h3>
                <p>{group.label}</p>
              </div>
              <a class="button" href={group.source!.file} target="_blank" rel="noopener noreferrer">
                <LucideIcon name="external-link" size={15} />
                <span>Buka berkas asli</span>
              </a>
            </div>
            <div class="source-unit-list">
              {units.map((unit) => (
                <details class="source-unit" id={`unit-${group.source!.id}-${unit.unit}`} open={unit.unit === group.start}>
                  <summary>
                    <span class="source-unit__number">{String(unit.unit).padStart(3, '0')}</span>
                    <span>{unit.heading || `${group.source!.unitLabel} ${unit.unit}`}</span>
                    <LucideIcon name="chevron-down" size={15} />
                  </summary>
                  <div class="source-unit__body">
                    {unit.text && <pre class="source-page pdf-page-text"><code>{unit.text}</code></pre>}
                    {unit.notes && <div class="source-notes"><strong>Catatan trainer/speaker</strong><p>{unit.notes}</p></div>}
                  </div>
                </details>
              ))}
            </div>
          </section>
        );
      })}
    </section>

    <section id="latihan-praktik" class="lesson-practice session-practice">
      <div class="section-heading section-heading--strong">
        <div><span class="section-number">05</span><h2>Latihan praktik</h2></div>
      </div>
      <ol>{current.practice.map((item, itemIndex) => <li><label class="check-row"><input type="checkbox" data-exercise={`${current.id}:${itemIndex}`} />{item}</label></li>)}</ol>
      <div class="session-task"><LucideIcon name="target" size={17} /><div><strong>Tugas sesi</strong><p>{current.task}</p></div></div>
    </section>

    <section id="checkpoint" class="lesson-checkpoint session-checkpoint">
      <div class="section-heading section-heading--strong">
        <div><span class="section-number">06</span><h2>Checkpoint</h2></div>
      </div>
      <p>Gunakan checkpoint sebagai bukti kemampuan. Selesai membaca saja belum cukup.</p>
      <ul>{current.checkpoint.map((item) => <li>{item}</li>)}</ul>
    </section>
  </article>

  <div class="toolbar">
    <Bookmark id={current.id + ':materi'} lessonId={current.id} title={current.title} url={current.url} type="materi" client:visible />
    <Bookmark id={current.id + ':latihan'} lessonId={current.id} title={'Latihan — ' + current.title} url={current.url + '#latihan-praktik'} type="latihan" client:visible />
  </div>
  <LessonTools id={current.id} title={current.title} url={current.url} checkpoints={checkpoints} client:load />

  <nav class="lesson-nav" aria-label="Navigasi sesi">
    {previous ? (
      <a href={previous.url}><small class="inline-icon-link"><LucideIcon name="arrow-left" size={14} /> Sesi sebelumnya</small>{previous.title}</a>
    ) : <a href="/belajar/">Kembali ke semua sesi</a>}
    {next ? (
      <a href={next.url}><small class="inline-icon-link">Sesi selanjutnya <LucideIcon name="arrow-right" size={14} /></small>{next.title}</a>
    ) : <a class="inline-icon-link" href="/progress/">Tinjau progress <LucideIcon name="arrow-right" size={14} /></a>}
  </nav>
</Layout>
