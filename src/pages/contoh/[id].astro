---
import { Code } from 'astro:components';
import { readFile, readdir } from 'node:fs/promises';
import { extname, join } from 'node:path';
import Layout from '../../layouts/Layout.astro';
import LucideIcon from '../../components/LucideIcon.astro';

import { examples } from '../../lib/examples';

export function getStaticPaths() {
  return Object.keys(examples).map((id) => ({ params: { id } }));
}

const { id } = Astro.params as { id: keyof typeof examples };
const root = join(process.cwd(), 'examples', id);
const ignored = new Set(['data', 'vendor', 'node_modules', '.git', 'dist', 'coverage']);
const language: Record<string, 'go' | 'css' | 'json' | 'yaml' | 'sql' | 'html' | 'typescript' | 'vue' | 'text'> = {
  '.go': 'go',
  '.css': 'css',
  '.json': 'json',
  '.yaml': 'yaml',
  '.yml': 'yaml',
  '.sql': 'sql',
  '.html': 'html',
  '.ts': 'typescript',
  '.vue': 'vue',
  '.mod': 'text',
  '.sum': 'text',
  '.example': 'text',
};

async function walk(directory: string): Promise<string[]> {
  const entries = await readdir(directory, { withFileTypes: true });
  const files: string[] = [];

  for (const entry of entries) {
    const privateEnv = entry.name.startsWith('.env') && entry.name !== '.env.example';
    if (ignored.has(entry.name) || privateEnv || entry.name.endsWith('.log')) continue;

    const path = join(directory, entry.name);
    if (entry.isDirectory()) {
      files.push(...await walk(path));
    } else if (!entry.name.endsWith('.sqlite') && !entry.name.endsWith('.zip')) {
      files.push(path);
    }
  }
  return files;
}

const files = await Promise.all((await walk(root)).map(async (path) => ({
  name: path.slice(root.length + 1).replaceAll('\\', '/'),
  code: await readFile(path, 'utf8'),
  lang: language[extname(path)] ?? 'text',
})));
files.sort((a, b) => a.name.localeCompare(b.name));
const title = examples[id];
---
<Layout title={title} wide>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/project/contoh/">Contoh project</a>
    <span>/</span>
    <span>{title}</span>
  </nav>

  <h1>{title}</h1>
  <p class="intro">Source lengkap ditampilkan langsung dari folder contoh. Jalankan di mesin belajar, bukan di browser website ini.</p>
  <a class="button primary" href={`/downloads/${id}.zip`} download>
    <LucideIcon name="download" size={16} />
    <span>Unduh seluruh source</span>
  </a>

  <h2>Struktur project</h2>
  <pre><code>{files.map((file) => file.name).join('\n')}</code></pre>

  <div class="prose">
    {files.map((file, index) => (
      <section id={`file-${index}`}>
        <h2>{file.name}</h2>
        <Code code={file.code} lang={file.lang} themes={{ light: 'github-light', dark: 'github-dark' }} />
        <p class="source-links">File lengkap · {file.code.split('\n').length} baris · {file.lang}</p>
      </section>
    ))}
  </div>
</Layout>
