---
import Layout from '../layouts/Layout.astro';
import LucideIcon from '../components/LucideIcon.astro';
import OfflineManager from '../components/OfflineManager.vue';
import Personal from '../components/Personal.vue';
import { summaries, parts } from '../lib/catalog';
import { staticRoutes } from '../lib/static-routes';

export function getStaticPaths() {
  return staticRoutes.map((route) => ({ params: { route } }));
}

const route = Astro.params.route!;
const titles: Record<string,string> = {
  roadmap: 'Roadmap',
  project: 'Project',
  progress: 'Progress',
  bookmark: 'Bookmark',
  notes: 'Catatan pribadi',
  offline: 'Offline',
  referensi: 'Referensi',
  tentang: 'Tentang template',
};
const title = titles[route] ?? 'Workspace';

const cards: Record<string, {title:string;description:string;icon:string;href:string}[]> = {
  roadmap: [
    {title:'Halaman baru',description:'Tempatkan struktur roadmap Anda di sini.',icon:'route',href:'/project/'},
    {title:'Alur kerja',description:'Definisikan tahapan yang dibutuhkan aplikasi.',icon:'workflow',href:'/project/'},
    {title:'Checkpoint',description:'Tambahkan target dan validasi Anda sendiri.',icon:'circle-check',href:'/progress/'},
  ],
  project: [
    {title:'Project kosong',description:'Mulai tambahkan project pertama Anda.',icon:'folder-kanban',href:'/project/'},
    {title:'Komponen',description:'Susun komponen reusable untuk aplikasi.',icon:'layout-template',href:'/project/'},
    {title:'Deployment',description:'Siapkan build dan deployment Anda.',icon:'rocket',href:'/project/'},
  ],
};
---
<Layout title={title} wide>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Workspace</a><span>/</span><span>{title}</span>
  </nav>

  {route === 'progress' && (
    <>
      <div class="page-kicker">PERSONAL DATA</div><h1>Progress</h1>
      <p class="intro">Kelola data lokal, backup, dan status workspace Anda.</p>
      <Personal mode="progress" lessons={summaries} parts={parts} client:load />
    </>
  )}

  {route === 'notes' && (
    <>
      <div class="page-kicker">PERSONAL DATA</div><h1>Catatan pribadi</h1>
      <p class="intro">Catatan Anda tersimpan secara lokal di browser.</p>
      <Personal mode="notes" lessons={summaries} parts={parts} client:load />
    </>
  )}

  {route === 'bookmark' && (
    <>
      <div class="page-kicker">PERSONAL DATA</div><h1>Bookmark</h1>
      <p class="intro">Simpan halaman penting dari workspace.</p>
      <Personal mode="bookmark" lessons={summaries} parts={parts} client:load />
    </>
  )}

  {route === 'offline' && (
    <>
      <div class="page-kicker">OFFLINE</div><h1>Mode offline</h1>
      <p class="intro">Simpan shell aplikasi untuk membuka workspace tanpa koneksi.</p>
      <OfflineManager client:load />
    </>
  )}

  {route === 'referensi' && (
    <>
      <div class="page-kicker">EMPTY</div><h1>Referensi</h1>
      <p class="intro">Tidak ada materi atau sumber bawaan pada template ini.</p>
      <div class="empty-state"><LucideIcon name="library" size={28}/><strong>Referensi kosong</strong><span>Tambahkan sumber Anda sendiri ketika workspace mulai digunakan.</span></div>
    </>
  )}

  {route === 'tentang' && (
    <>
      <div class="page-kicker">TEMPLATE</div><h1>Workspace template kosong</h1>
      <p class="intro">Template ini mempertahankan fondasi aplikasi dan fitur UI tetapi sengaja tidak membawa materi, contoh, source library, maupun data kurikulum.</p>
      <div class="chapter-grid">
        <article class="chapter-card"><LucideIcon name="palette" size={22}/><h2>UI system</h2><p>Responsive layout, theme, dark mode, icons, navigation, dialog, dan search.</p></article>
        <article class="chapter-card"><LucideIcon name="hard-drive-download" size={22}/><h2>Local storage</h2><p>Progress, bookmark, catatan, backup, import, dan offline shell.</p></article>
        <article class="chapter-card"><LucideIcon name="code-2" size={22}/><h2>Developer ready</h2><p>Struktur Astro + Vue + TypeScript siap dikembangkan dengan konten Anda sendiri.</p></article>
      </div>
    </>
  )}

  {cards[route] && (
    <>
      <div class="page-kicker">WORKSPACE</div><h1>{title}</h1>
      <p class="intro">Halaman ini sengaja kosong. Tambahkan data dan implementasi Anda sendiri.</p>
      <div class="feature-board">
        {cards[route].map((card) => (
          <a class="feature-card" href={card.href}>
            <span class="feature-icon"><LucideIcon name={card.icon as any} size={22}/></span>
            <span class="feature-kicker">READY</span>
            <h3>{card.title}</h3>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
      <div class="empty-state"><LucideIcon name="file-json" size={28}/><strong>Belum ada konten</strong><span>Folder data dan materi lama sudah dibersihkan dari template.</span></div>
    </>
  )}
</Layout>
