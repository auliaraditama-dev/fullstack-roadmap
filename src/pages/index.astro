---
import Layout from '../layouts/Layout.astro';
import LucideIcon from '../components/LucideIcon.astro';
import Personal from '../components/Personal.vue';
import levels from '../data/levels.json';
import sourceLibrary from '../data/source-library.json';
import fullstackChapters from '../data/fullstack-chapters.json';
import fullstackWeeks from '../data/fullstack-weeks.json';
import { catalog, parts, summaries } from '../lib/catalog';

const totalSourcePages = sourceLibrary.reduce((sum, source) => sum + source.pageCount, 0);

const partIcons = [
  'graduation-cap',
  'code-2',
  'git-branch',
  'layout-template',
  'server-cog',
  'database',
  'workflow',
  'shield-check',
  'rocket',
  'scroll-text',
] as const;
---
<Layout title="Ruang belajar" wide>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <div class="home-badges" aria-label="Informasi edisi">
        <span class="signal-badge signal-badge--violet"><LucideIcon name="code-2" size={14} /> Full-stack workspace</span>
        <span class="signal-badge signal-badge--amber">3 sumber PDF</span>
        <span class="signal-badge signal-badge--mint">{totalSourcePages} halaman</span>
      </div>

      <p class="home-overline">KURIKULUM BELAJAR MANDIRI</p>
      <h1 id="home-title">Belajar full-stack 2026 dari fondasi sampai production dalam workspace yang <span class="marker-underline">terstruktur dan bisa dipraktikkan.</span></h1>
      <p class="home-lead">Track lama Go + Vue + PostgreSQL tetap utuh. Track baru menambahkan 51 bab Full-Stack Developer 2026: PHP, Laravel, Vue 3, TypeScript, testing, security, Linux, deployment, Docker, CI/CD, Go, AI-assisted development, privacy, cloud, integrasi, dan portfolio. Ketiga PDF tersedia penuh per halaman sebagai sumber belajar.</p>

      <div class="home-actions">
        <a class="button primary button-strong" href={catalog[0]!.url}>
          <LucideIcon name="play" size={17} />
          <span>Mulai track fundamental</span>
        </a>
        <a class="button button-quiet" href="/materi-2026/">
          <LucideIcon name="library" size={17} />
          <span>Buka 51 bab materi 2026</span>
        </a>
      </div>

      <dl class="curriculum-stats" aria-label="Ringkasan kurikulum">
        <div><dt>{fullstackChapters.length}</dt><dd>Bab 2026</dd></div>
        <div><dt>{catalog.length}</dt><dd>Unit Go track</dd></div>
        <div><dt>{fullstackWeeks.length}</dt><dd>Minggu roadmap</dd></div>
        <div><dt>{totalSourcePages}</dt><dd>Halaman sumber</dd></div>
      </dl>
    </div>

    <aside class="hero-workbench" aria-label="Cara belajar di roadmap ini">
      <div class="workbench-topline">
        <span><span class="status-dot"></span> LEARNING WORKSPACE</span>
        <span>FS/26</span>
      </div>
      <div class="workbench-path">
        <div class="path-node path-node--blue"><span>01</span><strong>Pahami</strong><small>konsep &amp; mental model</small></div>
        <LucideIcon name="arrow-right" size={16} />
        <div class="path-node path-node--violet"><span>02</span><strong>Praktik</strong><small>kode dari nol</small></div>
        <LucideIcon name="arrow-right" size={16} />
        <div class="path-node path-node--orange"><span>03</span><strong>Bangun</strong><small>project bertahap</small></div>
        <LucideIcon name="arrow-right" size={16} />
        <div class="path-node path-node--green"><span>04</span><strong>Uji</strong><small>error &amp; trade-off</small></div>
      </div>
      <div class="workbench-terminal" aria-hidden="true">
        <span class="terminal-prompt">$</span>
        <span>belajar --step-by-step</span>
        <span class="terminal-cursor"></span>
      </div>
    </aside>
  </section>

  <section class="home-personal" aria-label="Progress belajar Anda">
    <Personal mode="home" lessons={summaries} parts={parts} client:load />
  </section>

  <section class="home-section" aria-labelledby="peta">
    <div class="section-heading section-heading--strong">
      <div>
        <span class="section-number">01</span>
        <h2 id="peta">Track lama tetap lengkap. Materi 2026 ditambahkan tanpa menimpa fondasi.</h2>
        <p>Gunakan jalur Go untuk latihan fundamental terarah, lalu perluas ke kurikulum full-stack 51 bab.</p>
      </div>
      <a class="inline-icon-link text-link" href="/materi-2026/">
        <span>Full materi 2026</span>
        <LucideIcon name="arrow-right" size={15} />
      </a>
    </div>

    <div class="roadmap-grid roadmap-grid--colorful">
      {parts.map((part, index) => (
        <a class={`roadmap-item roadmap-tone-${(index % 6) + 1}`} href={'/belajar/' + part.id + '/'}>
          <div class="roadmap-card-top">
            <span class="roadmap-icon"><LucideIcon name={partIcons[index] ?? 'book-open'} size={19} /></span>
            <span class="num">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <h3>{part.title}</h3>
          <small>{part.end - part.start + 1} bab · {index === 0 ? 'Mulai di sini' : `lanjut setelah ${parts[index - 1]?.title.toLowerCase()}`}</small>
          <span class="roadmap-arrow" aria-hidden="true"><LucideIcon name="arrow-up-right" size={17} /></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section build-section" aria-labelledby="bangun">
    <div class="section-heading section-heading--strong">
      <div>
        <span class="section-number">02</span>
        <h2 id="bangun">Bukan cuma baca. Ada hasil yang harus jadi.</h2>
        <p>Progress disimpan lokal di perangkat Anda dan dapat dibackup.</p>
      </div>
    </div>

    <div class="feature-board">
      <a class="feature-card feature-card--project" href="/project/task-tracker/">
        <span class="feature-icon"><LucideIcon name="folder-kanban" size={22} /></span>
        <span class="feature-kicker">PROJECT UTAMA</span>
        <h3>Task Tracker</h3>
        <p>{levels.length} level pengembangan: dari HTML statis sampai deployment production.</p>
        <span class="feature-link">Buka project <LucideIcon name="arrow-up-right" size={15} /></span>
      </a>

      <a class="feature-card feature-card--weeks" href="/roadmap-26-minggu/">
        <span class="feature-icon"><LucideIcon name="calendar" size={22} /></span>
        <span class="feature-kicker">RENCANA BELAJAR</span>
        <h3>{fullstackWeeks.length} minggu terukur</h3>
        <p>Roadmap 26 minggu dari environment dan Git sampai security, deployment, CI/CD, Go, dan portfolio.</p>
        <span class="feature-link">Lihat roadmap <LucideIcon name="arrow-up-right" size={15} /></span>
      </a>

      <a class="feature-card feature-card--practice" href="/latihan/">
        <span class="feature-icon"><LucideIcon name="target" size={22} /></span>
        <span class="feature-kicker">PRAKTIK</span>
        <h3>Latihan &amp; quiz</h3>
        <p>Uji pemahaman, bukan hafalan. Setiap materi punya checkpoint yang bisa Anda tandai sendiri.</p>
        <span class="feature-link">Mulai latihan <LucideIcon name="arrow-up-right" size={15} /></span>
      </a>

      <a class="feature-card feature-card--offline" href="/offline/">
        <span class="feature-icon"><LucideIcon name="hard-drive-download" size={22} /></span>
        <span class="feature-kicker">OFFLINE FIRST</span>
        <h3>Bawa materi tanpa internet</h3>
        <p>Unduh modul, simpan catatan dan bookmark, lalu lanjut belajar saat koneksi tidak stabil.</p>
        <span class="feature-link">Kelola offline <LucideIcon name="arrow-up-right" size={15} /></span>
      </a>
    </div>
  </section>

  <section class="home-section reference-ribbon" aria-labelledby="referensi-cepat">
    <div>
      <span class="section-number">03</span>
      <h2 id="referensi-cepat">Saat lupa sintaks, jangan kehilangan momentum.</h2>
      <p>Gunakan cheatsheet, glossary, pencarian global, bookmark, dan catatan sebagai meja kerja kedua.</p>
    </div>
    <div class="reference-links">
      <a href="/cheatsheet/"><LucideIcon name="scroll-text" size={18} /><span>Cheatsheet</span></a>
      <a href="/glossary/"><LucideIcon name="book-open-text" size={18} /><span>Glossary</span></a>
      <a href="/bookmark/"><LucideIcon name="bookmark" size={18} /><span>Bookmark</span></a>
      <a href="/notes/"><LucideIcon name="notebook-pen" size={18} /><span>Catatan</span></a>
    </div>
  </section>

  <section class="release-note" aria-label="Pembaruan materi">
    <div class="release-date"><span>UPDATED</span><time datetime="2026-09-29">29.09.2026</time></div>
    <div>
      <strong>Edisi digital full-stack 2026 · tiga sumber terintegrasi</strong>
      <p>{totalSourcePages} halaman sumber, 51 bab kurikulum, roadmap 26 minggu, track Go lama, latihan, quiz, progress lokal, project, offline mode, dan transkripsi per halaman tersedia dalam satu workspace.</p>
    </div>
    <a class="button button-quiet" href="/referensi/">Sumber materi <LucideIcon name="arrow-right" size={15} /></a>
  </section>
</Layout>
