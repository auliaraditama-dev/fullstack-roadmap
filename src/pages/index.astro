---
import Layout from '../layouts/Layout.astro';
import LucideIcon from '../components/LucideIcon.astro';
import Personal from '../components/Personal.vue';
import { summaries, parts } from '../lib/catalog';

const partIcons = ['layout-template','folder-kanban','chart','bookmark','notebook-pen','hard-drive-download'] as const;
---
<Layout title="Workspace Template" wide>
  <section class="home-hero" aria-labelledby="home-title">
    <div class="home-hero-copy">
      <div class="home-badges" aria-label="Informasi template">
        <span class="signal-badge signal-badge--violet"><LucideIcon name="library" size={14} /> Empty</span>
        <span class="signal-badge signal-badge--amber">Template</span>
        <span class="signal-badge signal-badge--mint">Ready</span>
      </div>
      <p class="home-overline">FULL-STACK WORKSPACE TEMPLATE</p>
      <h1 id="home-title">Workspace kosong dengan seluruh fondasi fitur siap dikembangkan.</h1>
      <p class="home-lead">Semua konten pembelajaran, contoh, sumber, dan data lama telah dihapus. Struktur UI, tema, pencarian, penyimpanan lokal, backup, bookmark, catatan, progress, dan mode offline tetap tersedia.</p>
      <div class="home-actions">
        <a class="button primary button-strong" href="/project/"><LucideIcon name="folder-kanban" size={17}/><span>Mulai dari Project</span></a>
        <a class="button button-quiet" href="/tentang/"><LucideIcon name="info" size={17}/><span>Lihat template</span></a>
      </div>
      <dl class="curriculum-stats" aria-label="Status template">
        <div><dt>0</dt><dd>Konten</dd></div>
        <div><dt>0</dt><dd>Materi</dd></div>
        <div><dt>0</dt><dd>Contoh</dd></div>
        <div><dt>∞</dt><dd>Ruang pengembangan</dd></div>
      </dl>
    </div>
    <aside class="hero-workbench" aria-label="Status workspace">
      <div class="workbench-topline"><span><span class="status-dot"></span> TEMPLATE</span><span>EMPTY</span></div>
      <div class="workbench-path">
        <div class="path-node path-node--blue"><span>01</span><strong>Tambah</strong><small>konten Anda</small></div><LucideIcon name="arrow-right" size={16}/>
        <div class="path-node path-node--violet"><span>02</span><strong>Bangun</strong><small>fitur Anda</small></div><LucideIcon name="arrow-right" size={16}/>
        <div class="path-node path-node--orange"><span>03</span><strong>Uji</strong><small>implementasi</small></div><LucideIcon name="arrow-right" size={16}/>
        <div class="path-node path-node--green"><span>04</span><strong>Deploy</strong><small>versi production</small></div>
      </div>
      <div class="workbench-terminal"><span class="terminal-prompt">$</span><span>npm run dev</span><span class="terminal-cursor"></span></div>
    </aside>
  </section>

  <section class="home-personal" aria-label="Data pribadi"><Personal mode="home" lessons={summaries} parts={parts} client:load /></section>

  <section class="home-section" aria-labelledby="fitur">
    <div class="section-heading section-heading--strong">
      <div><span class="section-number">01</span><h2 id="fitur">Fitur yang tetap tersedia</h2><p>Fondasi aplikasi lama dan fitur UI yang dapat digunakan kembali tanpa membawa konten lama.</p></div>
    </div>
    <div class="roadmap-grid roadmap-grid--colorful">
      {[
        ['/roadmap/','Roadmap','Kelola struktur halaman dan alur kerja.','route'],
        ['/project/','Project','Tempat utama untuk fitur dan project baru.','folder-kanban'],
        ['/progress/','Progress','Penyimpanan progress dan backup JSON lokal.','chart'],
        ['/bookmark/','Bookmark','Simpan halaman yang ingin ditandai.','bookmark'],
        ['/notes/','Catatan','Catatan pribadi tersimpan di browser.','notebook-pen'],
        ['/offline/','Offline','Mode offline untuk shell aplikasi.','hard-drive-download'],
      ].map(([href,title,description,icon], index) => (
        <a class={`roadmap-item roadmap-tone-${(index%6)+1}`} href={href}>
          <div class="roadmap-card-top"><span class="roadmap-icon"><LucideIcon name={icon as any} size={19}/></span><span class="num">{String(index+1).padStart(2,'0')}</span></div>
          <h3>{title}</h3><small>{description}</small><span class="roadmap-arrow"><LucideIcon name="arrow-up-right" size={17}/></span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section build-section" aria-labelledby="empty-state">
    <div class="section-heading section-heading--strong"><div><span class="section-number">02</span><h2 id="empty-state">Siap diisi</h2><p>Gunakan struktur ini sebagai titik awal untuk website, dashboard, dokumentasi, learning platform, atau aplikasi custom.</p></div></div>
    <div class="feature-board">
      <article class="feature-card feature-card--project"><span class="feature-icon"><LucideIcon name="folder-kanban" size={22}/></span><span class="feature-kicker">CONTENT</span><h3>Konten Anda</h3><p>Tambahkan halaman, data, komponen, dan alur aplikasi tanpa harus membersihkan konten lama.</p></article>
      <article class="feature-card"><span class="feature-icon"><LucideIcon name="palette" size={22}/></span><span class="feature-kicker">UI</span><h3>Theme &amp; Responsive</h3><p>Theme system, dark mode, mobile navigation, focus mode, dan komponen UI tetap tersedia.</p></article>
      <article class="feature-card"><span class="feature-icon"><LucideIcon name="database" size={22}/></span><span class="feature-kicker">LOCAL DATA</span><h3>Storage &amp; Backup</h3><p>Progress, bookmark, catatan, export, import, dan validasi data lokal tetap dipertahankan.</p></article>
    </div>
  </section>
</Layout>
